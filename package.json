    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "prettier": "^3",
    "tailwindcss": "^4",
